# ===================================
# Privacy Evidence Manager Configuration
# ===================================

# ===================================
# WALLET CONFIGURATION
# ===================================
# Private key for deployment (DO NOT COMMIT THE ACTUAL KEY)
PRIVATE_KEY=your_private_key_here

# Optional: Mnemonic phrase for multiple accounts
MNEMONIC=test test test test test test test test test test test junk

# ===================================
# NETWORK RPC ENDPOINTS
# ===================================
# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Alternative: SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Polygon Mumbai Testnet
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Ethereum Mainnet (for production)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Polygon Mainnet (for production)
POLYGON_RPC_URL=https://polygon-rpc.com

# ===================================
# BLOCK EXPLORER API KEYS
# ===================================
# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Polygonscan API Key
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Layer 2 Etherscan (Optimism, Arbitrum, etc.)
L2_ETHERSCAN_API_KEY=your_l2_etherscan_api_key_here

# ===================================
# GAS REPORTING & OPTIMIZATION
# ===================================
# Enable gas reporting (true/false)
REPORT_GAS=false

# CoinMarketCap API Key for USD gas pricing
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Gas Price API URL
GAS_PRICE_API=https://api.etherscan.io/api?module=proxy&action=eth_gasPrice

# ===================================
# CONTRACT SIZE MONITORING
# ===================================
# Enable contract size reporting during compilation
CONTRACT_SIZER=false

# ===================================
# SECURITY & MONITORING
# ===================================
# OpenZeppelin Defender API credentials
DEFENDER_API_KEY=your_defender_api_key_here
DEFENDER_API_SECRET=your_defender_api_secret_here

# Tenderly Project Configuration
TENDERLY_PROJECT=your_tenderly_project_name
TENDERLY_USERNAME=your_tenderly_username
TENDERLY_ACCESS_KEY=your_tenderly_access_key

# ===================================
# CI/CD & COVERAGE
# ===================================
# Codecov Token for coverage reporting
CODECOV_TOKEN=your_codecov_token_here

# ===================================
# DEPLOYED CONTRACT ADDRESSES
# ===================================
# Update these after deployment
CONTRACT_ADDRESS=
NETWORK_NAME=sepolia

# Sepolia Deployment
SEPOLIA_CONTRACT_ADDRESS=

# Mumbai Deployment
MUMBAI_CONTRACT_ADDRESS=

# Mainnet Deployment (Production)
MAINNET_CONTRACT_ADDRESS=

# ===================================
# ROLE ADDRESSES (Optional)
# ===================================
# Pre-configured role addresses
PAUSER_ADDRESS=
ADMIN_ADDRESS=
JUDGE_ADDRESS=
REVIEWER_ADDRESS=

# ===================================
# FRONTEND CONFIGURATION
# ===================================
# API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=11155111

# WalletConnect Project ID
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ===================================
# DEVELOPMENT SETTINGS
# ===================================
# Enable debug mode
DEBUG=false

# Verbose logging
VERBOSE=false

# Skip contract verification
SKIP_VERIFICATION=false

# ===================================
# TESTING CONFIGURATION
# ===================================
# Test network settings
TEST_NETWORK=hardhat
TEST_TIMEOUT=100000

# Enable parallel testing
TEST_PARALLEL=false

# ===================================
# PERFORMANCE OPTIMIZATION
# ===================================
# Solidity optimizer runs (higher = cheaper calls, more expensive deployment)
OPTIMIZER_RUNS=800

# Enable Yul optimizer
ENABLE_YUL=true

# Enable via-IR compilation
ENABLE_VIA_IR=false

# ===================================
# SECURITY AUDIT SETTINGS
# ===================================
# NPM audit level (low, moderate, high, critical)
AUDIT_LEVEL=moderate

# Fail on audit findings
FAIL_ON_AUDIT=false

# ===================================
# GIT HOOKS & PRE-COMMIT
# ===================================
# Skip pre-commit hooks (not recommended)
SKIP_PRECOMMIT=false

# Skip pre-push hooks (not recommended)
SKIP_PREPUSH=false

# ===================================
# RATE LIMITING & DOS PROTECTION
# ===================================
# Max requests per address per block
MAX_REQUESTS_PER_BLOCK=10

# Rate limit window (in blocks)
RATE_LIMIT_WINDOW=5

# Max gas per transaction
MAX_GAS_PER_TX=5000000

# ===================================
# MONITORING & ALERTS
# ===================================
# Webhook URL for alerts
ALERT_WEBHOOK_URL=

# Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=

# ===================================
# BACKUP & RECOVERY
# ===================================
# Backup RPC endpoints
BACKUP_RPC_URL=

# IPFS gateway for metadata
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Pinata API for IPFS pinning
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ===================================
# ADVANCED SETTINGS
# ===================================
# Custom gas multiplier (1.0 = no change, 1.2 = 20% increase)
GAS_MULTIPLIER=1.2

# Network timeout (milliseconds)
NETWORK_TIMEOUT=60000

# Number of confirmations to wait
CONFIRMATIONS=2

# ===================================
# NOTES
# ===================================
# 1. Never commit your actual .env file
# 2. Always use .env.example as a template
# 3. Keep your private keys secure
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. Rotate API keys regularly
# 6. Enable 2FA on all accounts
# 7. Use hardware wallets for mainnet deployments
# 8. Test thoroughly on testnet before mainnet deployment
# 9. Set up monitoring and alerts for deployed contracts
# 10. Keep backup of all credentials in secure location
